{
  "name": "@ficus/k8s-sandbox",
  "version": "0.2.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "private": true,
  "exports": {
    "./watcher": "./src/services/watcher.ts"
  },
  "scripts": {
    "test": "bun ../../scripts/test-runner.ts --isolated src",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "dev": "bun run --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "proto:generate": "buf generate proto"
  },
  "dependencies": {
    "@ficus/shared": "workspace:*",
    "bun-pty": "^0.4.8",
    "chokidar": "5.0.0",
    "micromatch": "^4.0.8"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/micromatch": "^4.0.10",
    "typescript": "^5.7.0"
  }
}
