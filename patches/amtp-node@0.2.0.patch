diff --git a/src/register-trace.ts b/src/register-trace.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3e2ac8d87f2a39ef34cbf8e59e973424021391f2
--- /dev/null
+++ b/src/register-trace.ts
@@ -0,0 +1,22 @@
+export type RegisterTracePhase =
+  | 'process:start'
+  | 'sqlite-open:start'
+  | 'sqlite-open:done'
+  | 'identity-read:done'
+  | 'registration-read:done'
+  | 'key-generate:start'
+  | 'key-generate:done'
+  | 'registration-write:start'
+  | 'registration-write:done'
+  | 'response-write:start'
+  | 'response-write:done'
+  | 'sqlite-close:start'
+  | 'sqlite-close:done'
+
+export function traceRegisterPhase(phase: RegisterTracePhase): void {
+  const operationId = process.env.AMTP_CONFORMANCE_OPERATION_ID
+  if (!operationId) return
+  process.stderr.write(
+    `${JSON.stringify({ kind: 'amtp-conformance-phase', operationId, operation: 'register', phase })}\n`
+  )
+}
diff --git a/src/upload-trace.ts b/src/upload-trace.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0bde83f6be4e40289c4853e400c6bd83e2236a87
--- /dev/null
+++ b/src/upload-trace.ts
@@ -0,0 +1,16 @@
+export type UploadTracePhase =
+  | 'process:start'
+  | 'sqlite-open:start' | 'sqlite-open:done'
+  | 'source-read:start' | 'source-read:done'
+  | 'digest:done'
+  | 'blob-file-fsync:start' | 'blob-file-fsync:done'
+  | 'blob-rename:done'
+  | 'blob-dir-fsync:start' | 'blob-dir-fsync:done'
+  | 'attachment-row-insert:start' | 'attachment-row-insert:done'
+  | 'response-write:start' | 'response-write:done'
+  | 'sqlite-close:start' | 'sqlite-close:done'
+
+export function traceUploadPhase(phase: UploadTracePhase): void {
+  if (process.env.AMTP_CONFORMANCE_TRACE_UPLOAD !== '1') return
+  process.stderr.write(`${JSON.stringify({ kind: 'amtp-upload-phase', phase })}\n`)
+}
