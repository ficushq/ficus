diff --git a/src/lifecycle-trace.ts b/src/lifecycle-trace.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2d1f514c811e97b134ff78134a108fc79200e068
--- /dev/null
+++ b/src/lifecycle-trace.ts
@@ -0,0 +1,23 @@
+export type LifecycleTracePhase =
+  | 'module-loaded'
+  | 'process:start'
+  | 'sqlite-open:start'
+  | 'sqlite-open:done'
+  | 'identity-read:start'
+  | 'identity-read:done'
+  | 'registrations-read:start'
+  | 'registrations-read:done'
+  | 'response-write:start'
+  | 'response-write:done'
+  | 'sqlite-close:start'
+  | 'sqlite-close:done'
+
+const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i
+
+export function traceLifecyclePhase(operation: 'entrypoint' | 'whoami', phase: LifecycleTracePhase): void {
+  const operationId = process.env.AMTP_CONFORMANCE_OPERATION_ID
+  if (!operationId || !UUID_PATTERN.test(operationId)) return
+  process.stderr.write(
+    `${JSON.stringify({ kind: 'amtp-conformance-phase', operationId, operation, phase })}\n`
+  )
+}
