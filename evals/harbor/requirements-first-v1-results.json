      "target_expectations": [
        {
          "requirement": "Second request, Response shape: _shape=lists default; _shape=objects returns objects including rowid; rowid not in columns.",
          "example": "On a dataset with columns name,age and row Ada,37, compare omitted _shape, _shape=lists and _shape=objects.",
          "expected": "The first two return row arrays; objects mode returns a row object with name=\"Ada\", age=37 and a source rowid. Columns remain [\"name\",\"age\"] and do not gain a synthetic rowid column.",
          "basis": "explicit"
        },
        {
          "requirement": "Second request, Response shape: rowid is the 1-based source-file row number; sorting precedes pagination.",
          "example": "Source data rows are A, B, C in that order; query objects sorted descending by name with offset 1 and size 1.",
          "expected": "The returned B retains its original source identity rather than acquiring a page-relative rowid. A plausible interpretation numbers data rows starting at 1, yielding rowid=2, but whether the header counts is not explicit.",
          "basis": "interpretation"
        },
        {
          "requirement": "Second request, Visibility toggles: _rowid=hide removes rowid; _total=hide removes total; only hide is valid.",
          "example": "Query _shape=objects&_rowid=hide&_total=hide; separately try _rowid=show, _rowid=, _total=show and _total=.",
          "expected": "The successful response omits synthetic rowid from each object and omits total, retaining ordinary dataset fields. Each invalid toggle returns HTTP 400 and a JSON error. A valid hide toggle does not require objects mode according to the stated parameter rules.",
          "basis": "explicit"
        },
        {
          "requirement": "Second request: any repeated control parameter among _size, _offset, _shape, _sort, _sort_desc, _rowid, _total is HTTP 400.",
          "example": "For each of the seven controls, send it twice with identical otherwise valid values, such as _size=2&_size=2 or _total=hide&_total=hide; also try differing values.",
          "expected": "Every repeated-control request returns HTTP 400 and the JSON error envelope, regardless of whether the repeated values agree. Different sort controls together are not repetition.",
          "basis": "explicit"
        }
      ],
      "target_ambiguities": [
        "The phrase 1-based source-file row number does not clearly say whether the header or physical lines inside quoted multiline fields count. Source identity should not be silently equated with page position."
      ],
