[Unit]
Description=Bounded credential-free managed BigBrain gateway
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=ficus-bb-gateway
Group=ficus-bb-gateway
Slice=ficus-bigbrain.slice
WorkingDirectory=/
UMask=0077
ExecStartPre=+/usr/local/bin/bun --no-install --no-env-file {{ARTIFACT_ROOT}}/ficus-bigbrain-host.js preflight gateway
ExecStart=/usr/bin/env -i HOME=/nonexistent PATH=/usr/bin:/bin LANG=C.UTF-8 BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 /usr/local/bin/bun --no-install --no-env-file {{ARTIFACT_ROOT}}/ficus-bigbrain-host.js gateway
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec,size=16M,mode=1777
TemporaryFileSystem=/var/tmp:rw,nosuid,nodev,noexec,size=16M,mode=1777
PrivateDevices=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:34792
TemporaryFileSystem=/etc/ficus:ro
# Bind the public directory, not the route inode: root publishes with atomic rename.
BindReadOnlyPaths=/etc/ficus/bigbrain/public
InaccessiblePaths=-/var/lib/ficus-bigbrain -/etc/ficus-core -/var/lib/ficus-core -/var/lib/ficus -/opt/ficus-core -/opt/ficus-machine
MemoryMax=134217728
MemorySwapMax=0
TasksMax=64
LimitNOFILE=128
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
