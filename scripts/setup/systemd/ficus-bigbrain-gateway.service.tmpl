[Unit]
Description=Bounded credential-free managed BigBrain gateway
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=ficus-bb-gateway
Group=ficus-bb-gateway
Slice=ficus-bigbrain.slice
WorkingDirectory=/
UMask=0077
ExecStart=/usr/bin/env -i HOME=/nonexistent PATH=/usr/bin:/bin LANG=C.UTF-8 {{ARTIFACT_ROOT}}/gateway
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
TemporaryFileSystem=/etc/ficus:ro
# Bind the public directory, not the route inode: root publishes with atomic rename.
BindReadOnlyPaths=/etc/ficus/bigbrain/public
InaccessiblePaths=-/var/lib/ficus-bigbrain -/etc/ficus-core -/var/lib/ficus-core -/var/lib/ficus -/opt/ficus-core -/opt/ficus-machine
MemoryMax=134217728
MemorySwapMax=0
TasksMax=64
LimitNOFILE=128
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
