# Rendered by scripts/setup/setup-host.sh — do not edit the installed copy by
# hand; re-run setup-host.sh (or edit this template) instead. Triggered by
# @UNIT_BACKUP@.timer; never enabled directly: its [Install] section holds at
# most an Alias= (the unit's name before the host layout migration).
[Unit]
Description=Ficus nightly encrypted backup (pg dump + HOME_DIR -> S3)
After=network-online.target@DB_AFTER@
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=@SCRIPT_PATH@
# Secrets (S3 keys, encryption passphrase) live only in this 0600 root-owned
# file — never in this unit, never in argv.
# Logs: journalctl -u @UNIT_BACKUP@
StandardOutput=journal
StandardError=journal

[Install]
@ALIAS@
