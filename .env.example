# ======================================================================# Tau Environment Configuration
# ======================================================================# Copy this file to .env and fill in the values.
# Both apps/core and apps/cli read from this file.
#
# SECRETS NOTE: API keys, tokens, and passwords below are auto-migrated into
# the database (encrypted) on first boot when FICUS_ENCRYPTION_KEY is set.
# After that, manage them via the Settings > Secrets & Keys page in the web UI.
# Values set via the UI take precedence over .env values.

# ======================================================================# Web Configuration
# ======================================================================
# Base path for the web app
# APP_BASE_PATH=/

# Allowed hosts for the web app (comma separated list)
# VITE_ALLOWED_HOSTS=localhost

# Serve the built web UI (apps/web/dist, from `bun run build:web`) from the
# core on PORT, alongside /api and /ws. 1|true|yes = serve (warns at boot if
# no build exists), 0|false|no = never, unset = auto (serve only when a build
# exists). Local dev with `bun run dev:web` (vite on 5173) works either way.
FICUS_SERVE_WEB=1

# ======================================================================# API Connection (CLI)
# ======================================================================
# URL of the Tau API server
FICUS_API_URL=http://localhost:3000

# ======================================================================# Authentication
# ======================================================================
# Password for API authentication (leave empty to disable auth)
# Used by both the API server and CLI
FICUS_PASSWORD=

# App-store reviewer access on a designated DEMO instance only (docs/wiki/demo-access.md).
# FICUS_DEMO_REVIEWER_ACCESS=1 serves /demo, where DEMO_REVIEWER_SECRET (16+ chars, rotate
# to revoke) yields a pairing code for the shared demo account created by `tau demo seed`.
# FICUS_DEMO_REVIEWER_ACCESS=1
# DEMO_REVIEWER_SECRET=

# WebAuthn / Passkey configuration (required for the passkey login admins/users use).
#
# WEBAUTHN_RP_ID — the BARE registrable domain only: no protocol, no port, NO path.
#   ✓ home.example.com        ✗ https://home.example.com        ✗ home.example.com/tau
#   If unset, defaults to the host of FICUS_WEB_ORIGIN (then APP_URL). Set explicitly only
#   to pin a parent domain. A wrong RP ID makes passkey registration fail.
# WEBAUTHN_RP_ID=home.example.com
# WEBAUTHN_RP_NAME=Tau    # human-readable name shown in the passkey dialog
#
# FICUS_WEB_ORIGIN — the browser app's BARE origin: scheme://host[:port], NO path.
#   Even when the app is served under a base path (APP_BASE_PATH=/tau, APP_URL=
#   https://host/tau), this must be just https://host — the WebAuthn ceremony rejects an
#   origin that includes a path. Drives the WebAuthn RP origin, the CORS allowlist, and the
#   session-cookie SameSite/Secure choice. Comma-separated for multiple origins (first is
#   canonical). Falls back to WEBAUTHN_ORIGIN then APP_URL (path stripped) if unset.
# FICUS_WEB_ORIGIN=https://your-domain.com

# Email Verification (AWS SES)
# AWS region for SES (falls back to AWS_REGION)
# AWS_SES_REGION=us-east-1
# Sender address for verification emails
# SES_FROM_ADDRESS=noreply@ficus.sh

# ======================================================================# Encryption
# ======================================================================
# 32-byte hex key for encrypting secrets in the database. REQUIRED for
# signing in to AI providers from the web UI (Settings > AI Providers) and for
# Settings > Secrets & Keys — without it those pages fail with
# "Cannot mutate secrets: FICUS_ENCRYPTION_KEY not configured" and credentials
# must live in config/agent/auth.json instead.
# Generate with: openssl rand -hex 32
FICUS_ENCRYPTION_KEY=

# ======================================================================# Server Configuration
# ======================================================================
# Root directory for Tau data (sessions, workspaces). Defaults to ~/.tau
# HOME_DIR=~/.tau

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tau

# API server port
PORT=3000

# tau-api and tau-worker exchange events (agent control signals, event
# forwarding, secret cache invalidation) over loopback HTTP. The worker's
# listener binds 127.0.0.1 on this port; the token authenticates both
# directions and MUST be the SAME value in both processes, so it belongs in the
# shared .env. If it is unset each process generates its own and every
# cross-process event is rejected (fail closed).
# Both processes must run on the same host — see docs/wiki/event-emitter.md.
# FICUS_WORKER_EVENT_PORT=3003
# FICUS_INTERNAL_EVENT_TOKEN=  # generate with: openssl rand -hex 32

# Public URL of the web app (used in notification links)
# Leave empty to omit URLs from notifications
APP_URL=https://your-domain.com

# Maximum concurrent agent runs
MAX_CONCURRENT_AGENTS=10

# Optional JSON object overriding built-in per-provider/model concurrency caps.
# Keys are provider or provider/modelId; defaults include {"zai":10}.
# PROVIDER_CONCURRENCY_LIMITS={"zai":10,"zai/glm-5.2":5}

# VAPID subject for push notifications (mailto: or https: URL)
# Required for iOS/Safari push — Apple rejects .local domains
VAPID_SUBJECT=mailto:you@example.com

# ======================================================================# Sandbox Configuration
# ======================================================================
# FICUS_SANDBOX_RUNTIME — REQUIRED. One of: docker-sysbox | docker-socket | k8s | vm | host.
# No default; the core refuses to start without it. See docs/wiki/sandbox-runtimes.md.
#   docker-sysbox - sysbox-runc containers (Linux only, strongest Docker isolation)
#   docker-socket - containers that mount the host Docker socket (macOS, Windows, Linux)
#   k8s           - Kubernetes pods with the sandbox service
#   vm            - VM ("box") sandboxes on a machine host
#   host          - NO sandbox: agents run on this machine as the current user
FICUS_SANDBOX_RUNTIME=

# Custom sandbox Docker image (defaults to tau-sandbox:latest)
# FICUS_SANDBOX_IMAGE=tau-sandbox:latest

# Sandbox pod/container memory limit (default: 4Gi, or 8Gi in local k3d mode)
# FICUS_SANDBOX_MEMORY_LIMIT=4Gi

# K8s storage classes for sandbox PVCs
# RWX (ReadWriteMany) for workspace and memory volumes
# FICUS_K8S_STORAGE_CLASS_RWX=do-block-storage-rwx
# RWO (ReadWriteOnce) for nix store volumes
# FICUS_K8S_STORAGE_CLASS_RWO=do-block-storage

# K8s RuntimeClass for sandbox pods (default: sysbox-runc)
# Provides secure Docker-in-Docker inside pods via user namespace isolation.
# Requires sysbox installed on K8s worker nodes.
# Set to empty string to disable (no RuntimeClass applied).
# FICUS_K8S_RUNTIME_CLASS=sysbox-runc

# --- Local K8s Development (k3d) ---
# Run sandboxes in a local k3d cluster instead of Docker containers.
# Setup: bun run k3d:setup   |   Management: bun run k3d:status
# Set FICUS_SANDBOX_RUNTIME=k8s above, plus:
# FICUS_K8S_LOCAL=true
# FICUS_K8S_NAMESPACE=tau-sandboxes-dev
# FICUS_K8S_RUNTIME_CLASS=

# --- No sandbox (host runtime) ---
# Set FICUS_SANDBOX_RUNTIME=host above to run agents directly on this machine as
# the current user (see docs/wiki/host-runtime.md). Zero isolation.


# ======================================================================# Optional Static Web Deploy Sync
# ======================================================================
# Optional local/bare-metal deployment hook for Caddy/nginx setups.
# When set, `bun run build:web` syncs apps/web/dist/ to this directory after
# the Vite build. Leave unset for normal development and container/K8s builds.
# WEB_DIST_SYNC_DIR=/var/www/tau

# Optional owner applied after syncing, useful when the web server runs as caddy
# or www-data. Leave unset to skip chown.
# WEB_DIST_SYNC_OWNER=caddy:caddy

# ======================================================================# External API Keys
# ======================================================================
# OpenAI API key (required for voice transcription and memory embeddings)
OPENAI_API_KEY=

# Brave Search API key (optional — enables web_search tool for agents)
# Get a key at https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Google Cloud TTS credentials (optional — enables text-to-speech playback)
# Path to service account JSON file for Google Cloud Text-to-Speech
GOOGLE_APPLICATION_CREDENTIALS=

# ======================================================================# GitHub Integration
# ======================================================================
# Configure GitHub accounts in Settings > Integrations.
# Standalone device login uses Tau's public GitHub App client ID; no private
# credential is required. Custom app settings are stored through Integrations.

# GitHub webhook secret (generate with: openssl rand -hex 32)
GITHUB_WEBHOOK_SECRET=

# ======================================================================# Linear Integration
# ======================================================================
# Legacy Linear webhook secret. Superseded by the Linear integration's webhook
# settings (Settings > Integrations > Linear > Webhook delivery, or
# GET/PUT /api/integrations/providers/linear/webhook). A value here is imported
# once on startup into that encrypted setting and never read again; leave it
# empty on a new install.
LINEAR_WEBHOOK_SECRET=

# ======================================================================# Discord Integration
# ======================================================================# Set up at https://discord.com/developers/applications

# Discord Application ID (from General Information)
DISCORD_APPLICATION_ID=

# Discord Public Key (from General Information)
# Used for verifying webhook signatures
DISCORD_PUBLIC_KEY=

# Discord Bot Token (from Bot section)
# Required for registering slash commands
DISCORD_BOT_TOKEN=

# Discord Guild ID (optional)
# Set for guild-specific commands (faster updates during development)
# Leave empty for global commands
DISCORD_GUILD_ID=

# ======================================================================# Slack Integration
# ======================================================================# Set up at https://api.slack.com/apps

# Slack Signing Secret (from Basic Information > App Credentials)
# Used for verifying webhook signatures
SLACK_SIGNING_SECRET=

# Slack Bot Token (xoxb-...) for posting messages and thread replies
# Required for channel reply feature - get from OAuth & Permissions in Slack app settings
SLACK_BOT_TOKEN=

# ======================================================================# Telegram Integration
# ======================================================================# Set up via @BotFather on Telegram

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram Webhook Secret (generated, 1-256 chars, A-Za-z0-9_- only)
# Set this when registering the webhook via setWebhook API
TELEGRAM_WEBHOOK_SECRET=

# Telegram Bot ID (your bot's username without @)
# Must match the botId in your channel instance config
TELEGRAM_BOT_ID=

# Kubernetes sandbox provisioning backpressure and circuit breaker
# FICUS_K8S_PROVISION_MAX_CONCURRENT=4
# FICUS_K8S_PROVISION_MAX_WAITERS=32
# FICUS_K8S_PROVISION_FAILURE_THRESHOLD=3
# FICUS_K8S_PROVISION_FAILURE_WINDOW_MS=60000
# FICUS_K8S_PROVISION_COOLDOWN_MS=30000

# Optional restricted directory for operator-triggered tau-api heap snapshots.
# When configured, SIGUSR2 captures one snapshot without restarting the process.
# FICUS_HEAP_SNAPSHOT_DIR=

