{
  "name": "core",
  "version": "0.2.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,worker -c blue,magenta 'bun run dev:api' 'bun run dev:worker'",
    "dev:api": "bun run --env-file ../../.env --watch src/index.ts",
    "dev:worker": "bun run --env-file ../../.env --watch src/worker.ts",
    "build": "bun build src/index.ts src/worker.ts src/smoke-configured-extensions.ts src/box-control.ts src/system-token-control.ts --outdir dist --target bun --external=bun-pty --external=jsdom --external=@silvia-odwyer/photon-node --external=@google-cloud/text-to-speech --external=@aws-sdk/client-ses --external=@aws-sdk/client-s3 --external=playwright-core --external=playwright && bun build src/db/run-migrations.ts --outfile dist/migrate.js --target bun --external=bun-pty --external=playwright-core --external=playwright && bun run build:docs",
    "start": "concurrently -n api,worker -c blue,magenta 'bun run start:api' 'bun run start:worker'",
    "start:api": "bun run dist/index.js",
    "start:worker": "bun run dist/worker.js",
    "test": "bun ../../scripts/run-core-tests.ts",
    "test:secret-boundaries": "bash ../../.github/run-secret-boundary-tests.sh",
    "test:db:up": "bun run src/test-db.ts up",
    "test:db:down": "bun run src/test-db.ts down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/run-migrations.ts",
    "db:push": "drizzle-kit push",
    "typecheck": "NODE_OPTIONS=\"${CORE_TYPECHECK_NODE_OPTIONS:-${NODE_OPTIONS:-}}\" tsc --noEmit",
    "activity:repair": "bun run src/scripts/repair-squad-activity.ts",
    "usage:backfill": "bun run src/scripts/backfill-execution-usage.ts",
    "build:docs": "bun run --cwd ../docs build:embedded"
  },
  "dependencies": {
    "amtp-engine": "^0.1.2",
    "amtp-protocol": "^0.1.2",
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "@aws-sdk/client-s3": "^3.999.0",
    "@aws-sdk/client-ses": "^3.1005.0",
    "@earendil-works/pi-agent-core": "0.99.1",
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@hono/zod-validator": "^0.4.0",
    "@kubernetes/client-node": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.0.1",
    "@simplewebauthn/server": "^13.3.0",
    "@sinclair/typebox": "^0.34.48",
    "@ficus/sandbox-server": "workspace:*",
    "@ficus/shared": "workspace:*",
    "archiver": "^7.0.1",
    "bun-pty": "^0.4.8",
    "chokidar": "5.0.0",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.38.0",
    "entities": "7.0.1",
    "hono": "^4.7.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^27.0.1",
    "marked": "18.0.5",
    "micromatch": "^4.0.8",
    "openai": "^6.19.0",
    "playwright-core": "1.58.2",
    "postgres": "^3.4.0",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "web-push": "^3.6.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bun": "^1.3.9",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.7",
    "@types/micromatch": "^4.0.10",
    "@types/turndown": "^5.0.5",
    "@types/web-push": "^3.6.4",
    "amtp-node": "^0.1.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.30.0",
    "ntn": "0.22.10",
    "typescript": "^5.7.0"
  },
  "trustedDependencies": [
    "ntn"
  ]
}
