{
  "name": "@ficus/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "ASTRO_TELEMETRY_DISABLED=1 FICUS_DOCS_EMBEDDED=0 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "check:links": "bun scripts/check-links.ts",
    "test": "bun test scripts",
    "check": "bun run typecheck && bun run test && bun run build && bun run check:links && bun run build:embedded",
    "build:embedded": "ASTRO_TELEMETRY_DISABLED=1 FICUS_DOCS_EMBEDDED=1 astro build && bun scripts/check-links.ts --embedded"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.0",
    "@astrojs/markdown-remark": "7.3.0",
    "astro": "7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/bun": "^1.3.8",
    "parse5": "^8.0.0",
    "typescript": "^5.7.0",
    "happy-dom": "^20.11.2"
  }
}
