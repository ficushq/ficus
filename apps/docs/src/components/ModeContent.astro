---
interface Props {
  mode: 'cloud' | 'self-hosted'
}
const { mode } = Astro.props
const label = mode === 'cloud' ? 'Ficus Cloud' : 'Self-hosted'
const otherMode = mode === 'cloud' ? 'self-hosted' : 'cloud'
const otherLabel = mode === 'cloud' ? 'Self-hosted' : 'Ficus Cloud'
---

<section class="docs-mode-content" data-docs-only={mode} aria-label={`${label} instructions`} data-pagefind-ignore>
  <div class="docs-mode-caption">
    <span>{label}</span>
    <button type="button" data-docs-mode-switch={otherMode}>Switch to {otherLabel}</button>
  </div>
  <slot />
</section>
