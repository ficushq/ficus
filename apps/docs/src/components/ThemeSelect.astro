---
import DefaultThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro'
---

<div class="docs-preferences">
  <label class="docs-mode-picker">
    <span class="sr-only">Documentation setup</span>
    <select data-docs-mode-select aria-label="Documentation setup">
      <option value="cloud">Ficus Cloud</option>
      <option value="self-hosted">Self-hosted</option>
    </select>
  </label>
  <DefaultThemeSelect />
</div>
